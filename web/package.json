{
  "name": "opennoise-atlas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "types": "node generate-types.mjs",
    "dev": "npm run types && vite --host 0.0.0.0",
    "check": "npm run types && tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "lint": "prettier --check src/main.ts src/data.ts src/preview.ts src/map-geometry.ts src/map-canvas.ts src/label-grid.ts src/keyboard.ts src/navigation.ts src/tree-layout.ts src/tree-scene.ts src/genre-tree.ts tests/*.mjs src/style.css index.html vite.config.ts tsconfig.json package.json generate-types.mjs",
    "build": "npm run check && vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@panzoom/panzoom": "4.6.2",
    "ajv": "8.18.0",
    "ajv-formats": "3.0.1",
    "rbush": "3.0.1"
  },
  "devDependencies": {
    "@types/rbush": "3.0.4",
    "json-schema-to-typescript": "15.0.4",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "6.4.6"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 100
  }
}
