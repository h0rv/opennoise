"""One explicitly approved four-member capture; never retries or substitutes."""
from hashlib import sha256
import json
from pathlib import Path

from opennoise.ingest.fma.corpus import project_row, source_rows, verify_sources
from opennoise.serving.metadata import fma_large32 as large, fma_listening64 as small
from opennoise.deployment.fma_playback import decode_duration

ROOT = Path('/workspace/opennoise-rebuild-20261013')
proposal_path = ROOT / 'next-four-artist-proposal.json'
assert sha256(proposal_path.read_bytes()).hexdigest() == '46bfebb15e32a850ac04b18e884a51d543a80b79d04c76fb139dc7c53068fd4a'
proposal = json.loads(proposal_path.read_bytes())
items = proposal['tracks']
assert len(items) == 4 and len({r['track_id'] for r in items}) == 4
probe, members = large.verify_probe(ROOT / 'large-probe')
assert probe['etag'] == json.loads((ROOT / 'listening8/listening.json').read_bytes())['captures'][0]['etag']
assert proposal['source_url'] == large.URL
receipt = verify_sources(ROOT / 'metadata-source')
rows, checked, handles = source_rows(ROOT / 'metadata-source', receipt['members']['fma_metadata/raw_tracks.csv'])
expected = {r['track_id']: r for r in items}
matched = set()
try:
    for raw in rows:
        row = project_row('tracks', raw)
        if row['track_id'] not in expected:
            continue
        item = expected[row['track_id']]
        assert row['artist_id'] == item['artist_id'] and row['genre_ids'] == item['genre_ids']
        assert {key: raw.get(key, '') for key in item['source']} == item['source']
        assert raw['license_url'] in ('http://creativecommons.org/licenses/by/3.0/', 'http://creativecommons.org/licenses/by/4.0/')
        assert members[row['track_id']] == item['member']
        matched.add(row['track_id'])
    assert checked.complete and matched == set(expected)
    native_sha = checked.sha256.hexdigest()
finally:
    for handle in handles:
        handle.close()
# Verify the proposed independence against the frozen split and exact finite features.
import io
import numpy as np
import zstandard
with (ROOT / 'baseline44/native-folds.jsonl.zst').open('rb') as raw, zstandard.ZstdDecompressor().stream_reader(raw) as stream:
    roles = {r['track_id']: r for line in io.TextIOWrapper(stream) if (r := json.loads(line))}
previous = [r for folder in ('listening60','listening32','listening8') for r in json.loads((ROOT / folder / 'listening.json').read_bytes())['tracks']]
old_ids = {r['track_id'] for r in previous}
old_artists = {r['artist_id'] for r in previous}
old_components = {roles[i]['component_id'] for i in old_ids}
assert len({item['component_id'] for item in items}) == 4
ids = np.fromfile(ROOT / 'feature-source/projection/track_ids.uint32', dtype='<u4')
features = np.memmap(ROOT / 'feature-source/projection/features.float32', dtype='<f4', mode='r', shape=(len(ids),44))
lookup = {int(t):i for i,t in enumerate(ids)}
for item in items:
    identity = item['track_id']
    assert identity not in old_ids and item['artist_id'] not in old_artists
    assert item['artist_id'] == roles[identity]['artist_id']
    assert item['component_id'] == roles[identity]['component_id'] and item['component_id'] not in old_components
    assert np.isfinite(features[lookup[identity]]).all()
independence = {'all_four_new_artist_and_component': True, 'all_four_finite_mean44': True, 'roles_sha256': sha256((ROOT / 'baseline44/native-folds.jsonl.zst').read_bytes()).hexdigest(), 'features_sha256': sha256((ROOT / 'feature-source/projection/features.float32').read_bytes()).hexdigest(), 'track_ids_sha256': sha256((ROOT / 'feature-source/projection/track_ids.uint32').read_bytes()).hexdigest()}
output = ROOT / 'listening4'
output.mkdir(exist_ok=False)
(output / 'proposal.json').write_bytes(proposal_path.read_bytes())
(output / 'capture-script.py').write_bytes(Path(__file__).read_bytes())
captures = []
tracks = []


def request(client, name, start, end):
    # Extra strict scope guards sit in front of the unchanged native request verifier.
    size = end - start + 1
    assert len(captures) < 8 and 0 < size <= 2_000_000
    assert sum(r['bytes'] for r in captures) + size <= 3_108_139
    return large._request(client, output, name, start, end, captures, phase='audio', total=probe['archive_bytes'], etag=probe['etag'])


with large._client() as client:
    for item in items:
        identity, member = item['track_id'], item['member']
        header = request(client, f'{identity}-header.range', member['offset'], member['offset'] + 29)
        start, end, prefix = small._payload_bounds((output / header['path']).read_bytes(), item, probe['directory']['start'])
        payload = request(client, f'{identity}-payload.range', start, end)
        audio = small._audio((output / payload['path']).read_bytes(), prefix, member)
        assert sum(r['audio_bytes'] for r in tracks) + len(audio) <= 3_004_625
        path = output / f'{identity}.mp3'
        path.write_bytes(audio)
        duration = decode_duration(path)
        tracks.append({**item, 'audio_path': path.name, 'audio_sha256': sha256(audio).hexdigest(), 'audio_bytes': len(audio), 'duration_seconds': duration})
        print(json.dumps({'track_id': identity, 'verified_duration': duration, 'audio_bytes': len(audio)}), flush=True)
result = {
    'revision': 'fma-four-artist-capture-v1', 'tracks': tracks, 'captures': captures,
    'proposal_sha256': sha256(proposal_path.read_bytes()).hexdigest(),
    'native_track_csv_sha256': native_sha,
    'source_receipt_sha256': sha256((ROOT / 'metadata-source/source-receipt.json').read_bytes()).hexdigest(),
    'probe_sha256': sha256((ROOT / 'large-probe/probe.json').read_bytes()).hexdigest(),
    'response_bytes': sum(r['bytes'] for r in captures), 'audio_bytes': sum(r['audio_bytes'] for r in tracks),
    'full_archive_hash_verified': False, 'musical_quality_validated': False, 'public_deployment_authorized': False,
}
# Exact audio-only range replay; all attempts and original records must agree.
for number, record in enumerate(captures, 1):
    attempt = json.loads((output / record['attempt']).read_bytes())
    body = (output / record['path']).read_bytes()
    assert record['attempt'] == f'attempt-{number:03}.json'
    assert attempt['state'] == 'complete' and attempt['phase'] == 'audio'
    assert attempt['url'] == large.URL and attempt['status'] == 206
    assert attempt['range'] == f"bytes={record['start']}-{record['end']}"
    assert attempt['content_range'] == f"bytes {record['start']}-{record['end']}/{probe['archive_bytes']}"
    assert attempt['etag'] == probe['etag'] and attempt['observed_at'] == record['observed_at']
    assert attempt['received_bytes'] == record['bytes'] == len(body)
    assert attempt['sha256'] == record['sha256'] == sha256(body).hexdigest()
for i, item in enumerate(tracks):
    header, payload = captures[2*i:2*i+2]
    hb, pb = [(output / record['path']).read_bytes() for record in (header,payload)]
    start, end, prefix = small._payload_bounds(hb, item, probe['directory']['start'])
    assert (start, end) == (payload['start'], payload['end'])
    assert small._audio(pb, prefix, item['member']) == (output / item['audio_path']).read_bytes()
assert len(captures) == 8 and result['audio_bytes'] == 3_004_625
result['component_and_feature_verification'] = independence
(output / 'listening.json').write_text(json.dumps(result, indent=2, sort_keys=True) + '\n')
print(json.dumps({'completed': True, 'requests': len(captures), 'response_bytes': result['response_bytes'], 'audio_bytes': result['audio_bytes']}), flush=True)
